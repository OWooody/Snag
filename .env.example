# Snag relay secrets (set in Supabase Edge Function secrets)
SNAG_KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SNAG_WEBHOOK_SECRET=change-me-to-a-random-webhook-secret

# Standard Supabase (auto-injected in hosted functions; needed locally)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
