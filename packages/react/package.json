{
  "name": "@snag-tech/react",
  "version": "0.9.0",
  "description": "Snag — in-app change requests that launch AI coding agents. React web SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWooody/Snag.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/OWooody/Snag/issues"
  },
  "homepage": "https://github.com/OWooody/Snag/tree/main/packages/react#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "keywords": [
    "react",
    "feedback",
    "ai-agent",
    "developer-tools"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "perfect-freehand": "^1.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
